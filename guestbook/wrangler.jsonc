{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "okorion-guestbook",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/api/*"
    ]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFlAFE4wyjb7D3or"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "okorion-guestbook",
      "database_id": "88d498c9-b5ad-434c-9ca1-1d37887939d6"
    }
  ],
  "ratelimits": [
    {
      "name": "SUBMISSIONS",
      "namespace_id": "2010256127",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "observability": {
    "enabled": false
  }
}
